<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CAT Rumah Belajar DIO - Simulasi Ujian IPAS Kelas 4</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dioBlue: '#0284c7',
                        dioDarkBlue: '#1e3a8a',
                        dioGreen: '#10b981',
                        dioLightGreen: '#dcfce7',
                        dioYellow: '#f59e0b',
                    },
                    aspectRatio: {
                        '16/9': '16 / 9',
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #e0f2fe 0%, #f0fdf4 100%);
            min-height: 100vh;
            user-select: none; /* Security lockdown simulation */
        }
        
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #0284c7;
            border-radius: 4px;
        }

        .screen-container {
            max-width: 1280px;
            margin: 0 auto;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .cat-card {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        /* Sidebar animation transition */
        .sidebar-transition {
            transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
        }

        /* Prevent text selection */
        .no-select {
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            -khtml-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }
    </style>
</head>
<body class="no-select text-slate-800 antialiased flex items-center justify-center p-2 sm:p-4 md:p-6 min-h-screen">

    <!-- Global Container with Responsive Aspect Ratio Frame -->
    <div class="w-full max-w-6xl mx-auto my-auto flex flex-col justify-center min-h-[90vh]">

        <!-- Tut Wuri Handayani & Header Section -->
        <header class="text-center mb-4 flex flex-col items-center justify-center">
            <div class="bg-white p-3 rounded-full shadow-md mb-2 border-2 border-blue-500 inline-block transform hover:scale-105 transition-transform">
                <!-- SVG Logo Tut Wuri Handayani -->
                <svg class="w-14 h-14 sm:w-16 sm:h-16 text-blue-700" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Outer Hexagon / Wings Symbolism -->
                    <path d="M100 10 L180 50 L180 150 L100 190 L20 150 L20 50 Z" fill="#0284c7" stroke="#0284c7" stroke-width="4"/>
                    <path d="M100 22 L168 56 L168 144 L100 178 L32 144 L32 56 Z" fill="#ffffff"/>
                    <!-- Inner Flame & Wings -->
                    <path d="M100 40 L115 75 L150 75 L120 95 L132 130 L100 108 L68 130 L80 95 L50 75 L85 75 Z" fill="#10b981"/>
                    <circle cx="100" cy="140" r="14" fill="#f59e0b"/>
                    <!-- Tut Wuri Handayani Text Arc representation -->
                    <path d="M60 160 Q 100 180 140 160" stroke="#0284c7" stroke-width="6" stroke-linecap="round" fill="none"/>
                </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-blue-900 tracking-tight">RUMAH BELAJAR DIO</h1>
            <p class="text-xs sm:text-sm font-semibold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full mt-1 inline-block border border-emerald-300">
                Sistem CAT (Computer Assisted Test) IPAS Kelas 4
            </p>
        </header>

        <!-- ==================== HALAMAN 1: LOGIN ==================== -->
        <section id="page-login" class="w-full flex justify-center items-center">
            <div class="cat-card w-full max-w-md p-6 sm:p-8 rounded-3xl border border-blue-200">
                <div class="text-center mb-6">
                    <h2 class="text-xl font-bold text-slate-800">Login Peserta Ujian</h2>
                    <p class="text-xs text-slate-500 mt-1">Masukkan Username & Password untuk memulai</p>
                </div>

                <!-- Notification Alert Box -->
                <div id="login-error" class="hidden mb-4 p-3 bg-red-100 border-l-4 border-red-500 text-red-700 text-xs sm:text-sm rounded shadow-sm">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i>
                    <span id="login-error-msg">Username atau password salah!</span>
                </div>

                <form id="form-login" onsubmit="handleLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="username">Username</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                                <i class="fa-solid fa-user"></i>
                            </span>
                            <input type="text" id="username" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm font-medium text-slate-800" placeholder="Ketik Username" required>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="password">Password</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input type="password" id="password" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm font-medium text-slate-800" placeholder="Ketik Password" required>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white font-bold py-3 rounded-xl shadow-lg shadow-blue-500/30 transition-all text-sm flex items-center justify-center gap-2 mt-6">
                        <span>MASUK SISTEM UJIAN</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>

                <div class="mt-6 pt-4 border-t border-slate-100 text-center">
                    <span class="text-[11px] text-slate-400">Rumah Belajar DIO &copy; 2026 - All Rights Reserved</span>
                </div>
            </div>
        </section>

        <!-- ==================== HALAMAN 2: IDENTITAS PESERTA ==================== -->
        <section id="page-identity" class="hidden w-full flex justify-center items-center">
            <div class="cat-card w-full max-w-lg p-6 sm:p-8 rounded-3xl border border-blue-200">
                <div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-5">
                    <div>
                        <h2 class="text-lg font-bold text-slate-800">Lengkapi Data Peserta</h2>
                        <p class="text-xs text-slate-500">Periksa dan lengkapi profil sebelum tes</p>
                    </div>
                    <span class="bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full border border-blue-200">Tahap 2 dari 3</span>
                </div>

                <form id="form-identity" onsubmit="handleStartExam(event)" class="space-y-4">
                    <!-- Nama Lengkap (Locked) -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nama Lengkap Peserta</label>
                        <div class="relative">
                            <input type="text" id="identity-nama" value="MUHAMMAD ARFANDIO MAHADI" disabled class="w-full px-4 py-2.5 rounded-xl bg-slate-100 border border-slate-300 text-slate-600 text-sm font-bold cursor-not-allowed">
                            <span class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400" title="Terkunci">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">*Nama lengkap otomatis dikunci oleh sistem</p>
                    </div>

                    <!-- Kelas -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="identity-kelas">Kelas</label>
                        <input type="text" id="identity-kelas" value="4B" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm font-semibold text-slate-800">
                    </div>

                    <!-- Tempat Lahir & Tanggal Lahir Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="identity-tempat">Tempat Lahir</label>
                            <input type="text" id="identity-tempat" placeholder="Contoh: Jakarta" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm text-slate-800">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="identity-tanggal">Tanggal Lahir</label>
                            <input type="date" id="identity-tanggal" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm text-slate-800">
                        </div>
                    </div>

                    <!-- Ringkasan Ujian -->
                    <div class="bg-blue-50 p-4 rounded-2xl border border-blue-200 mt-4 text-xs space-y-1.5 text-blue-900">
                        <div class="font-bold flex items-center gap-1.5 text-blue-800 text-sm mb-1">
                            <i class="fa-solid fa-circle-info"></i> Ketentuan Ujian CAT IPAS:
                        </div>
                        <p>• Jumlah Soal: <strong>30 Soal (15 PG, 10 PG Kompleks, 5 Benar/Salah)</strong></p>
                        <p>• Waktu Pengerjaan: <strong>60 Menit</strong> (Hitung Mundur)</p>
                        <p>• Skor Maksimal: <strong>100 Poin</strong></p>
                        <p>• Jawaban tersimpan otomatis, siswa dapat mengirim sebelum waktu habis.</p>
                    </div>

                    <div class="flex gap-3 pt-2">
                        <button type="button" onclick="goToLogin()" class="w-1/3 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold py-3 rounded-xl transition-all text-sm">
                            Kembali
                        </button>
                        <button type="submit" class="w-2/3 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold py-3 rounded-xl shadow-lg shadow-emerald-500/30 transition-all text-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-play"></i>
                            <span>MULAI SOAL UJIAN</span>
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- ==================== HALAMAN 3: SOAL UJIAN CAT ==================== -->
        <section id="page-exam" class="hidden w-full relative">
            
            <!-- Top Exam Navbar (Sticky Header) -->
            <div class="bg-white rounded-2xl p-3 sm:p-4 shadow-md border border-slate-200 mb-4 flex flex-wrap items-center justify-between gap-3">
                <!-- User Info -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-lg shadow">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                    <div>
                        <h3 id="exam-student-name" class="font-bold text-sm sm:text-base text-slate-800 leading-tight">MUHAMMAD ARFANDIO MAHADI</h3>
                        <p class="text-xs text-slate-500">Kelas: <span id="exam-student-class" class="font-semibold text-blue-600">4B</span> | <span id="exam-student-ttg">Jakarta</span></p>
                    </div>
                </div>

                <!-- Timer & Controls -->
                <div class="flex items-center gap-2 sm:gap-3 ml-auto">
                    <!-- Timer Badge -->
                    <div class="bg-amber-50 border-2 border-amber-400 text-amber-800 px-3 py-1.5 rounded-xl flex items-center gap-2 shadow-sm">
                        <i class="fa-solid fa-stopwatch text-amber-600 animate-pulse text-base"></i>
                        <div class="text-right">
                            <div class="text-[10px] font-bold text-amber-600 uppercase tracking-wider leading-none">Sisa Waktu</div>
                            <div id="timer-display" class="font-mono text-base sm:text-lg font-black leading-tight text-amber-900">60:00</div>
                        </div>
                    </div>

                    <!-- Toggle Sidebar Button -->
                    <button onclick="toggleSidebar()" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2 shadow transition-all" title="Buka Navigasi Soal">
                        <i class="fa-solid fa-th-large"></i>
                        <span class="hidden sm:inline">Navigasi Soal</span>
                    </button>
                </div>
            </div>

            <!-- Main Question & Sidebar Workspace Layout -->
            <div class="relative flex flex-col lg:flex-row gap-4 items-start">
                
                <!-- Main Question Card Area (Takes Full Width when drawer closed) -->
                <div class="w-full flex-1 cat-card rounded-3xl p-4 sm:p-6 md:p-8 border border-slate-200 relative min-h-[500px] flex flex-col justify-between">
                    
                    <!-- Question Top Header -->
                    <div>
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-3 mb-4">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="bg-blue-600 text-white font-extrabold text-sm sm:text-base px-3 py-1 rounded-xl shadow">
                                    Soal No. <span id="current-q-num">1</span>
                                </span>
                                <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200" id="current-q-category">
                                    IPAS Kelas 4
                                </span>
                                <span class="text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-200" id="current-q-type-badge">
                                    Pilihan Ganda
                                </span>
                            </div>
                            <!-- Save indicator status -->
                            <div class="flex items-center text-xs text-emerald-600 font-medium bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                                <i class="fa-solid fa-cloud-check mr-1.5"></i>
                                <span>Otomatis Tersimpan</span>
                            </div>
                        </div>

                        <!-- Question Body Stimulus & Text -->
                        <div class="space-y-4 mb-6">
                            <!-- Visual Graphic / Table Stimulus Container -->
                            <div id="question-stimulus" class="bg-slate-50 p-3 sm:p-4 rounded-2xl border border-slate-200 text-sm overflow-x-auto">
                                <!-- Dynamic Stimulus Injector -->
                            </div>

                            <!-- Question Text -->
                            <div id="question-text" class="text-sm sm:text-base font-semibold text-slate-800 leading-relaxed space-y-2">
                                <!-- Dynamic Question Text -->
                            </div>
                        </div>

                        <!-- Dynamic Options / Checkbox / True-False Table Container -->
                        <div class="space-y-3" id="options-container">
                            <!-- Dynamic Options Rendered Here -->
                        </div>
                    </div>

                    <!-- Question Navigation Footer Actions -->
                    <div class="pt-6 mt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3">
                        <button onclick="navigateQuestion(-1)" id="btn-prev" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-4 py-2.5 rounded-xl text-xs sm:text-sm flex items-center gap-2 transition-all">
                            <i class="fa-solid fa-chevron-left"></i>
                            <span>Sebelumnya</span>
                        </button>

                        <button onclick="toggleDoubt()" id="btn-doubt" class="bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold px-4 py-2.5 rounded-xl text-xs sm:text-sm flex items-center gap-2 transition-all border border-amber-300">
                            <i id="doubt-icon" class="fa-regular fa-flag"></i>
                            <span id="doubt-text">Ragu-Ragu</span>
                        </button>

                        <button onclick="navigateQuestion(1)" id="btn-next" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs sm:text-sm flex items-center gap-2 shadow transition-all ml-auto">
                            <span>Selanjutnya</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>

                        <button onclick="confirmFinishExam()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs sm:text-sm flex items-center gap-2 shadow-md shadow-emerald-600/30 transition-all">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>Selesai & Kirim</span>
                        </button>
                    </div>

                </div>

                <!-- Auto-Hide Navigation Sidebar Overlay / Panel -->
                <div id="sidebar-drawer" class="fixed inset-y-0 right-0 z-40 w-80 max-w-[85vw] bg-white shadow-2xl border-l border-slate-200 p-5 transform translate-x-full sidebar-transition flex flex-col justify-between">
                    <div>
                        <!-- Sidebar Header -->
                        <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-200">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-list-ol text-blue-600 text-lg"></i>
                                <h4 class="font-bold text-slate-800 text-base">Navigasi Soal (1-30)</h4>
                            </div>
                            <button onclick="toggleSidebar(false)" class="text-slate-400 hover:text-slate-700 p-1 text-lg">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <!-- Legend Status Indicators -->
                        <div class="grid grid-cols-3 gap-2 mb-4 text-[11px] font-semibold text-center">
                            <div class="bg-emerald-100 text-emerald-800 p-1.5 rounded-lg border border-emerald-300">
                                <span class="block text-emerald-600 font-bold" id="count-answered">0</span> Sudah
                            </div>
                            <div class="bg-amber-100 text-amber-800 p-1.5 rounded-lg border border-amber-300">
                                <span class="block text-amber-600 font-bold" id="count-doubt">0</span> Ragu
                            </div>
                            <div class="bg-slate-100 text-slate-700 p-1.5 rounded-lg border border-slate-300">
                                <span class="block text-slate-500 font-bold" id="count-unanswered">30</span> Belum
                            </div>
                        </div>

                        <!-- 1-30 Number Grid -->
                        <div id="question-grid" class="grid grid-cols-5 gap-2 max-h-[60vh] overflow-y-auto p-1">
                            <!-- Dynamic 1-30 Buttons Rendered Here -->
                        </div>
                    </div>

                    <!-- Sidebar Bottom Actions -->
                    <div class="pt-4 border-t border-slate-200">
                        <button onclick="confirmFinishExam()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-xs sm:text-sm flex items-center justify-center gap-2 shadow">
                            <i class="fa-solid fa-check-double"></i>
                            <span>Selesai Ujian Sekarang</span>
                        </button>
                    </div>
                </div>

                <!-- Backdrop Overlay for Mobile Drawer -->
                <div id="drawer-backdrop" onclick="toggleSidebar(false)" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-30 hidden transition-opacity"></div>

            </div>
        </section>

        <!-- ==================== HALAMAN 4: HASIL SKOR & PEMBAHASAN ==================== -->
        <section id="page-result" class="hidden w-full flex justify-center items-center py-4">
            <div class="cat-card w-full max-w-3xl p-6 sm:p-8 rounded-3xl border border-blue-200">
                <!-- Header Score Badge -->
                <div class="text-center pb-6 border-b border-slate-200">
                    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-100 border-4 border-emerald-500 text-emerald-600 text-3xl mb-3 shadow-inner">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <h2 class="text-2xl font-black text-slate-800">Hasil Ujian CAT IPAS Selesai</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Rumah Belajar DIO - Laporan Capaian Nilai</p>
                </div>

                <!-- Student Identity & Score Summary Card -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-6">
                    <!-- Profile Card -->
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 md:col-span-1 flex flex-col justify-center space-y-1 text-xs">
                        <div class="text-slate-400 font-bold uppercase tracking-wider text-[10px]">Identitas Siswa</div>
                        <div id="res-student-nama" class="font-bold text-sm text-slate-800">MUHAMMAD ARFANDIO MAHADI</div>
                        <div id="res-student-kelas" class="text-slate-600">Kelas: 4B</div>
                        <div id="res-student-ttg" class="text-slate-500">Jakarta</div>
                    </div>

                    <!-- Total Score Display -->
                    <div class="bg-gradient-to-br from-blue-600 to-emerald-600 text-white p-5 rounded-2xl md:col-span-2 flex items-center justify-between shadow-lg">
                        <div>
                            <div class="text-xs font-bold uppercase tracking-widest opacity-80">Skor Akhir Kamu</div>
                            <div id="res-total-score" class="text-4xl sm:text-5xl font-black tracking-tight my-1">100 / 100</div>
                            <div id="res-grade-status" class="text-xs font-semibold bg-white/20 px-3 py-1 rounded-full inline-block">Sangat Memuaskan!</div>
                        </div>
                        <div class="text-right text-xs space-y-1">
                            <div class="bg-white/20 px-3 py-1 rounded-lg"><span class="font-bold">Benar:</span> <span id="res-correct-count">30</span> Soal</div>
                            <div class="bg-white/20 px-3 py-1 rounded-lg"><span class="font-bold">Salah:</span> <span id="res-wrong-count">0</span> Soal</div>
                            <div class="bg-white/20 px-3 py-1 rounded-lg"><span class="font-bold">Waktu Terpakai:</span> <span id="res-time-used">12m 30s</span></div>
                        </div>
                    </div>
                </div>

                <!-- Accordion/Review Discussion Section -->
                <div class="mt-6">
                    <h3 class="font-bold text-slate-800 text-base mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-book-open text-blue-600"></i>
                        <span>Pembahasan Soal Lengkap</span>
                    </h3>
                    <div id="review-container" class="space-y-4 max-h-[400px] overflow-y-auto pr-2">
                        <!-- Dynamic Question Review Breakdown injected here -->
                    </div>
                </div>

                <!-- Footer Action Buttons -->
                <div class="mt-8 pt-4 border-t border-slate-200 flex flex-wrap gap-3 justify-end">
                    <button onclick="resetTest()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-3 rounded-xl text-sm shadow flex items-center gap-2 transition-all">
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>Ulangi Ujian / Logout</span>
                    </button>
                </div>
            </div>
        </section>

    </div>

    <!-- ==================== MODAL DIALOGS ==================== -->
    
    <!-- Confirm Submit Modal -->
    <div id="modal-confirm" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 transform transition-all">
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-xl mb-4 mx-auto">
