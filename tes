            const bsQuestions = rawQuestionBank.filter(q => q.type === 'bs').sort(() => Math.random() - 0.5);

            state.questions = [...pgQuestions, ...pgkQuestions, ...bsQuestions];
            state.userAnswers = {};
            state.doubtFlags = {};
            state.currentIndex = 0;
            state.timeStarted = Date.now();
            state.timerSeconds = 3600;

            saveToStorage();

            showPage('page-exam');
            initExamView();
            startTimer();
        }

        /* ==================== HALAMAN 3: EXAM CAT ENGINE ==================== */
        function initExamView() {
            // Set Header Identity
            document.getElementById('exam-student-name').innerText = state.student.nama;
            document.getElementById('exam-student-class').innerText = state.student.kelas;
            document.getElementById('exam-student-ttg').innerText = `${state.student.tempatLahir}, ${state.student.tanggalLahir}`;

            renderQuestion();
            renderGridNav();
            updateCounts();
        }

        function renderQuestion() {
            const q = state.questions[state.currentIndex];
            if (!q) return;

            document.getElementById('current-q-num').innerText = state.currentIndex + 1;
            document.getElementById('current-q-category').innerText = q.category;

            // Badge tipe soal
            const typeBadge = document.getElementById('current-q-type-badge');
            if (q.type === 'pg') {
                typeBadge.innerText = 'Pilihan Ganda';
                typeBadge.className = 'text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-200';
            } else if (q.type === 'pgk') {
                typeBadge.innerText = 'Pilihan Ganda Kompleks (Ceklis)';
                typeBadge.className = 'text-xs font-bold text-purple-700 bg-purple-50 px-2.5 py-1 rounded-lg border border-purple-200';
            } else if (q.type === 'bs') {
                typeBadge.innerText = 'Benar / Salah';
                typeBadge.className = 'text-xs font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded-lg border border-teal-200';
            }

            document.getElementById('question-stimulus').innerHTML = q.stimulus;
            document.getElementById('question-text').innerHTML = q.question;

            // Render Options according to question type
            const optContainer = document.getElementById('options-container');
            optContainer.innerHTML = '';

            if (q.type === 'pg') {
                // Pilihan Ganda (Single Select)
                const selectedAns = state.userAnswers[state.currentIndex];

                Object.keys(q.options).forEach(letter => {
                    const isSelected = selectedAns === letter;
                    const optBtn = document.createElement('button');
                    optBtn.type = 'button';
                    optBtn.onclick = () => selectOption(letter);
                    optBtn.className = `w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3 text-xs sm:text-sm ${
                        isSelected 
                        ? 'border-blue-600 bg-blue-50/80 text-blue-900 font-bold shadow-md' 
                        : 'border-slate-200 bg-white hover:border-slate-300 text-slate-700 hover:bg-slate-50'
                    }`;

                    optBtn.innerHTML = `
                        <div class="w-7 h-7 rounded-xl flex items-center justify-center font-bold text-xs shrink-0 ${
                            isSelected ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-600 border border-slate-300'
                        }">
                            ${letter}
                        </div>
                        <div class="pt-0.5">${q.options[letter]}</div>
                    `;
                    optContainer.appendChild(optBtn);
                });

            } else if (q.type === 'pgk') {
                // Pilihan Ganda Kompleks (Checkbox Multi Select)
                const selectedArr = Array.isArray(state.userAnswers[state.currentIndex]) ? state.userAnswers[state.currentIndex] : [];

                const hintBanner = document.createElement('div');
                hintBanner.className = 'text-xs text-purple-800 bg-purple-50 border border-purple-200 px-3 py-2 rounded-xl flex items-center gap-2 font-medium';
                hintBanner.innerHTML = '<i class="fa-solid fa-square-check text-purple-600"></i> <span>Klik kotak ceklis untuk memilih <strong>lebih dari satu</strong> jawaban yang benar.</span>';
                optContainer.appendChild(hintBanner);

                Object.keys(q.options).forEach(letter => {
                    const isChecked = selectedArr.includes(letter);
                    const optBtn = document.createElement('button');
                    optBtn.type = 'button';
                    optBtn.onclick = () => toggleCheckboxOption(letter);
                    optBtn.className = `w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-start gap-3 text-xs sm:text-sm ${
                        isChecked 
                        ? 'border-purple-600 bg-purple-50/80 text-purple-950 font-bold shadow-md' 
                        : 'border-slate-200 bg-white hover:border-slate-300 text-slate-700 hover:bg-slate-50'
                    }`;

                    optBtn.innerHTML = `
                        <div class="w-7 h-7 rounded-lg flex items-center justify-center text-base shrink-0 ${
                            isChecked ? 'bg-purple-600 text-white' : 'bg-slate-100 text-slate-400 border border-slate-300'
                        }">
                            <i class="${isChecked ? 'fa-solid fa-check' : 'fa-regular fa-square text-transparent'}"></i>
                        </div>
                        <div class="pt-0.5 flex-1">
                            <span class="font-bold mr-1 text-purple-700">${letter}.</span> ${q.options[letter]}
                        </div>
                    `;
                    optContainer.appendChild(optBtn);
                });

            } else if (q.type === 'bs') {
                // Benar / Salah (Tabel Pernyataan)
                const currentArr = Array.isArray(state.userAnswers[state.currentIndex])
                    ? state.userAnswers[state.currentIndex]
                    : new Array(q.statements.length).fill(null);

                const tableWrapper = document.createElement('div');
                tableWrapper.className = 'overflow-x-auto rounded-2xl border border-slate-300 bg-white shadow-xs';

                let rowsHtml = '';
                q.statements.forEach((stmt, sIdx) => {
                    const val = currentArr[sIdx];
                    rowsHtml += `
                        <tr class="border-t border-slate-200 hover:bg-slate-50/80 transition-colors">
                            <td class="p-3 text-center font-bold text-slate-500 text-xs align-middle">${sIdx + 1}</td>
                            <td class="p-3 text-xs sm:text-sm text-slate-800 font-medium leading-relaxed align-middle">${stmt}</td>
                            <td class="p-2.5 text-center align-middle">
                                <button type="button" onclick="selectTrueFalse(${sIdx}, true)"
                                    class="w-full min-w-[68px] py-2 px-2.5 rounded-xl border-2 text-xs font-bold transition-all flex items-center justify-center gap-1.5 ${
                                        val === true
                                        ? 'bg-emerald-600 border-emerald-600 text-white shadow-sm'
                                        : 'bg-white border-slate-300 text-slate-600 hover:border-emerald-400'
                                    }">
                                    <i class="${val === true ? 'fa-solid fa-circle-check' : 'fa-regular fa-circle'}"></i>
                                    <span>Benar</span>
                                </button>
                            </td>
                            <td class="p-2.5 text-center align-middle">
                                <button type="button" onclick="selectTrueFalse(${sIdx}, false)"
                                    class="w-full min-w-[68px] py-2 px-2.5 rounded-xl border-2 text-xs font-bold transition-all flex items-center justify-center gap-1.5 ${
                                        val === false
                                        ? 'bg-rose-600 border-rose-600 text-white shadow-sm'
                                        : 'bg-white border-slate-300 text-slate-600 hover:border-rose-400'
                                    }">
                                    <i class="${val === false ? 'fa-solid fa-circle-xmark' : 'fa-regular fa-circle'}"></i>
                                    <span>Salah</span>
                                </button>
                            </td>
                        </tr>
                    `;
                });

                tableWrapper.innerHTML = `
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-blue-900 text-white text-xs uppercase tracking-wider">
                                <th class="p-3 text-center w-10">No</th>
                                <th class="p-3">Pernyataan</th>
                                <th class="p-3 text-center w-24">Benar</th>
                                <th class="p-3 text-center w-24">Salah</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${rowsHtml}
                        </tbody>
                    </table>
                `;
                optContainer.appendChild(tableWrapper);
            }

            // Update Doubt Button State
            const isDoubt = !!state.doubtFlags[state.currentIndex];
            const btnDoubt = document.getElementById('btn-doubt');
            const doubtIcon = document.getElementById('doubt-icon');
            const doubtText = document.getElementById('doubt-text');

            if (isDoubt) {
                btnDoubt.className = "bg-amber-500 text-white font-bold px-4 py-2.5 rounded-xl text-xs sm:text-sm flex items-center gap-2 transition-all shadow border border-amber-600";
                doubtIcon.className = "fa-solid fa-flag text-white";
                doubtText.innerText = "Terandai Ragu";
            } else {
                btnDoubt.className = "bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold px-4 py-2.5 rounded-xl text-xs sm:text-sm flex items-center gap-2 transition-all border border-amber-300";
                doubtIcon.className = "fa-regular fa-flag text-amber-700";
                doubtText.innerText = "Ragu-Ragu";
            }

            // Button Disable Checks
            document.getElementById('btn-prev').disabled = (state.currentIndex === 0);
            document.getElementById('btn-prev').style.opacity = (state.currentIndex === 0) ? '0.5' : '1';
            
            document.getElementById('btn-next').disabled = (state.currentIndex === state.questions.length - 1);
            document.getElementById('btn-next').style.opacity = (state.currentIndex === state.questions.length - 1) ? '0.5' : '1';

            renderGridNav();
        }

        function selectOption(letter) {
            state.userAnswers[state.currentIndex] = letter;
            saveToStorage();
            renderQuestion();
            updateCounts();
        }

        function toggleCheckboxOption(letter) {
            let current = Array.isArray(state.userAnswers[state.currentIndex]) ? [...state.userAnswers[state.currentIndex]] : [];
            if (current.includes(letter)) {
                current = current.filter(item => item !== letter);
            } else {
                current.push(letter);
                current.sort();
            }

            if (current.length === 0) {
                delete state.userAnswers[state.currentIndex];
            } else {
                state.userAnswers[state.currentIndex] = current;
            }

            saveToStorage();
            renderQuestion();
            updateCounts();
        }

        function selectTrueFalse(stmtIdx, boolVal) {
            const q = state.questions[state.currentIndex];
            let current = Array.isArray(state.userAnswers[state.currentIndex])
                ? [...state.userAnswers[state.currentIndex]]
                : new Array(q.statements.length).fill(null);

            current[stmtIdx] = boolVal;
            state.userAnswers[state.currentIndex] = current;

            saveToStorage();
            renderQuestion();
            updateCounts();
        }

        function toggleDoubt() {
            state.doubtFlags[state.currentIndex] = !state.doubtFlags[state.currentIndex];
            saveToStorage();
            renderQuestion();
            updateCounts();
        }

        function navigateQuestion(direction) {
            const newIdx = state.currentIndex + direction;
            if (newIdx >= 0 && newIdx < state.questions.length) {
                state.currentIndex = newIdx;
                saveToStorage();
                renderQuestion();
            }
        }

        function jumpToQuestion(idx) {
            state.currentIndex = idx;
            saveToStorage();
            renderQuestion();
            toggleSidebar(false);
        }

        function renderGridNav() {
            const grid = document.getElementById('question-grid');
            if (!grid) return;
            grid.innerHTML = '';

            state.questions.forEach((q, idx) => {
                const isCurrent = (idx === state.currentIndex);
                const hasAnswer = isQuestionAnswered(idx);
                const isDoubt = !!state.doubtFlags[idx];

                let bgClass = "bg-slate-100 text-slate-700 border-slate-300";
                if (isDoubt) {
                    bgClass = "bg-amber-400 text-slate-900 border-amber-500 font-black";
                } else if (hasAnswer) {
                    bgClass = "bg-emerald-600 text-white border-emerald-700 font-bold";
                }

                if (isCurrent) {
                    bgClass += " ring-4 ring-blue-400 ring-offset-1";
                }

                const btn = document.createElement('button');
                btn.onclick = () => jumpToQuestion(idx);
                btn.className = `h-10 rounded-xl border text-xs flex items-center justify-center transition-all ${bgClass}`;
                btn.innerText = idx + 1;
                grid.appendChild(btn);
            });
        }

        function updateCounts() {
            const total = state.questions.length;
            let answered = 0;
            for (let i = 0; i < total; i++) {
                if (isQuestionAnswered(i)) answered++;
            }
            const doubt = Object.keys(state.doubtFlags).filter(k => state.doubtFlags[k]).length;
            const unanswered = total - answered;

            document.getElementById('count-answered').innerText = answered;
            document.getElementById('count-doubt').innerText = doubt;
            document.getElementById('count-unanswered').innerText = unanswered;
        }

        function toggleSidebar(forceState) {
            const drawer = document.getElementById('sidebar-drawer');
            const backdrop = document.getElementById('drawer-backdrop');
            
            const isOpen = drawer.classList.contains('translate-x-0');
            const shouldOpen = (forceState !== undefined) ? forceState : !isOpen;

            if (shouldOpen) {
                drawer.classList.remove('translate-x-full');
                drawer.classList.add('translate-x-0');
                backdrop.classList.remove('hidden');
            } else {
                drawer.classList.remove('translate-x-0');
                drawer.classList.add('translate-x-full');
                backdrop.classList.add('hidden');
            }
        }

        function startTimer() {
            if (state.timerInterval) clearInterval(state.timerInterval);

            function tick() {
                if (state.timerSeconds <= 0) {
                    clearInterval(state.timerInterval);
                    autoSubmitExam();
                    return;
                }

                // Low time alert check (e.g. at 5 minutes = 300s)
                if (state.timerSeconds === 300) {
                    openModal('modal-lowtime');
                }

                state.timerSeconds--;
                saveToStorage();

                const mins = Math.floor(state.timerSeconds / 60);
                const secs = state.timerSeconds % 60;
                document.getElementById('timer-display').innerText = 
                    `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            }

            tick();
            state.timerInterval = setInterval(tick, 1000);
        }

        /* ==================== SUBMISSION & RESULT LOGIC ==================== */
        function confirmFinishExam() {
            let answered = 0;
            for (let i = 0; i < state.questions.length; i++) {
                if (isQuestionAnswered(i)) answered++;
            }
            const doubt = Object.keys(state.doubtFlags).filter(k => state.doubtFlags[k]).length;
            const unanswered = state.questions.length - answered;

            document.getElementById('modal-ans-count').innerText = answered;
            document.getElementById('modal-doubt-count').innerText = doubt;
            document.getElementById('modal-unans-count').innerText = unanswered;

            openModal('modal-confirm');
        }

        function autoSubmitExam() {
            submitExam();
        }

        function submitExam() {
            closeModal('modal-confirm');
            if (state.timerInterval) clearInterval(state.timerInterval);

            state.isSubmitted = true;
            state.timeFinished = Date.now();
            saveToStorage();

            renderResultView();
            showPage('page-result');
        }

        function formatReviewAnswer(q, ans, isKey = false) {
            if (q.type === 'pg') {
                if (!ans) return 'Tidak Dijawab';
                return `${ans}. ${q.options[ans]}`;
            } else if (q.type === 'pgk') {
                if (!Array.isArray(ans) || ans.length === 0) return 'Tidak Dijawab';
                return ans.map(letter => `${letter}. ${q.options[letter]}`).join('<br>');
            } else if (q.type === 'bs') {
                if (!Array.isArray(ans) || ans.every(v => v === null)) return 'Tidak Dijawab';
                return q.statements.map((stmt, i) => {
                    const val = ans[i];
                    const label = val === true ? 'Benar' : (val === false ? 'Salah' : 'Belum diisi');
                    return `(${i + 1}) ${label}`;
                }).join(' | ');
            }
            return '-';
        }

        function renderResultView() {
            document.getElementById('res-student-nama').innerText = state.student.nama;
            document.getElementById('res-student-kelas').innerText = `Kelas: ${state.student.kelas}`;
            document.getElementById('res-student-ttg').innerText = `${state.student.tempatLahir}, ${state.student.tanggalLahir}`;

            // Calculate Score
            let correctCount = 0;
            state.questions.forEach((q, idx) => {
                if (isQuestionCorrect(idx)) {
                    correctCount++;
                }
            });

            const totalQuestions = state.questions.length;
            const totalScore = Math.round((correctCount / totalQuestions) * 100);
            const wrongCount = totalQuestions - correctCount;

            document.getElementById('res-total-score').innerText = `${totalScore} / 100`;
            document.getElementById('res-correct-count').innerText = correctCount;
            document.getElementById('res-wrong-count').innerText = wrongCount;

            // Status Badge
            const statusEl = document.getElementById('res-grade-status');
            if (totalScore >= 85) {
                statusEl.innerText = "Sangat Memuaskan (A)";
            } else if (totalScore >= 70) {
                statusEl.innerText = "Baik (B)";
            } else if (totalScore >= 55) {
                statusEl.innerText = "Cukup (C)";
            } else {
                statusEl.innerText = "Perlu Belajar Lagi (D)";
            }

            // Time Used calculation
            const elapsedSeconds = 3600 - state.timerSeconds;
            const mins = Math.floor(elapsedSeconds / 60);
            const secs = elapsedSeconds % 60;
            document.getElementById('res-time-used').innerText = `${mins}m ${secs}s`;

            // Render Detailed Review Breakdown
            const reviewContainer = document.getElementById('review-container');
            reviewContainer.innerHTML = '';

            state.questions.forEach((q, idx) => {
                const userAns = state.userAnswers[idx];
                const isCorrect = isQuestionCorrect(idx);

                const item = document.createElement('div');
                item.className = `p-4 rounded-2xl border ${
                    isCorrect ? 'bg-emerald-50/60 border-emerald-200' : 'bg-red-50/60 border-red-200'
                }`;

                item.innerHTML = `
                    <div class="flex items-center justify-between border-b border-slate-200/60 pb-2 mb-2">
                        <span class="font-bold text-xs ${isCorrect ? 'text-emerald-800' : 'text-red-800'}">
                            Soal No. ${idx + 1} (${q.category})
                        </span>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full ${
                            isCorrect ? 'bg-emerald-200 text-emerald-800' : 'bg-red-200 text-red-800'
                        }">
                            ${isCorrect ? '<i class="fa-solid fa-check mr-1"></i> Benar' : '<i class="fa-solid fa-xmark mr-1"></i> Salah'}
                        </span>
                    </div>

                    <div class="text-xs text-slate-700 font-medium mb-2">${q.question}</div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs mb-3">
                        <div class="p-2 rounded-xl bg-white border border-slate-200">
                            <span class="text-slate-400 font-bold block text-[10px]">Jawaban Kamu:</span>
                            <span class="font-bold ${isCorrect ? 'text-emerald-600' : 'text-red-600'}">
                                ${formatReviewAnswer(q, userAns, false)}
                            </span>
                        </div>
                        <div class="p-2 rounded-xl bg-emerald-100/60 border border-emerald-300">
                            <span class="text-emerald-700 font-bold block text-[10px]">Kunci Jawaban Benar:</span>
                            <span class="font-bold text-emerald-800">
                                ${formatReviewAnswer(q, q.answer, true)}
                            </span>
                        </div>
                    </div>

                    <div class="bg-white/80 p-3 rounded-xl border border-slate-200 text-[11px] text-slate-600">
                        <strong class="text-blue-700 block mb-0.5"><i class="fa-solid fa-lightbulb text-amber-500 mr-1"></i> Pembahasan:</strong>
                        ${q.explanation}
                    </div>
                `;

                reviewContainer.appendChild(item);
            });
        }

        /* ==================== MODAL HELPERS ==================== */
        function openModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.remove('hidden');
        }

        function closeModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('hidden');
        }

        function resetTest() {
            localStorage.removeItem(STORAGE_KEY);
            location.reload();
        }
    </script>
</body>
</html>
